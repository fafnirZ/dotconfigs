# diff tool #
#############
cdiff() {
    # args file1 file2
    local f1=$1
    local f2=$2
    if [ $# -lt 2 ]; then
        echo "usage: cdiff <file1> <file2>"
        return
    fi


    diff \
        --side-by-side \
        --suppress-common-lines \
        --color=always \
        $1 \
        $2 \
        | less -r
}

