# Select a GCP project interactively and copy a decoded secret to clipboard
gproj() {
  local cache=~/.cache/gcloud-projects
  # refresh cache if older than a day
  if [[ ! -f $cache || $(find "$cache" -mtime +1) ]]; then
    gcloud projects list --filter="lifecycleState:ACTIVE AND NOT projectId:sys-*" \
        --format="value(projectId)" > "$cache"
  fi
  fzf --prompt="Project> " < "$cache"
}
gsecret() {
  local project secret

  project=$(gproj) || return
  secret=$(gcloud secrets list --project="$project" --format="value(name)" | fzf --prompt="Secret> ") || return   
  copy_or_print=$(fzf --prompt="Project> " <<EOF
print
copy_to_clipboard
EOF
) || return

  if [ $copy_or_print = "print" ]; then
      gcloud secrets versions access latest \
        --secret="$secret" \
        --project="$project" \
        --format='get(payload.data)' | tr '_-' '/+' | base64 -d
  else
      gcloud secrets versions access latest \
        --secret="$secret" \
        --project="$project" \
        --format='get(payload.data)' | tr '_-' '/+' | base64 -d | clip.exe
    echo "Copied '$secret' from '$project' to clipboard"
  fi
}

gssh() {
    local project
    project=$(gproj) || return
    selected_instance=$(gcloud compute instances list \
        --project="$project" \
        --format="value(name)" \
        --filter="status:RUNNING" \
            | fzf --prompt="Instance>") || return
    gcloud compute ssh --project="$project" "$selected_instance"
}

gcloud_daily_login() {
    # Prompt to log in to gcloud, at most once per day
    local GCLOUD_STAMP

    GCLOUD_STAMP="$HOME/.gcloud_last_login"
    if ! command -v gcloud >/dev/null 2>&1; then
        return
    fi

    # $- == *i* checks if the shell is interactive, prevents it from hanging during non-interactive session like scripts
    if [[ $- == *i* ]] && [ "$(cat "$GCLOUD_STAMP" 2>/dev/null)" != "$(date +%F)" ]; then
        # timeout so a slow network / hung gcloud can't block shell startup
        if timeout 5 gcloud auth print-access-token >/dev/null 2>&1; then
            # Already authenticated; no need to ask today
            date +%F > "$GCLOUD_STAMP"
        else
            local reply=""
            printf "log in to gcloud cli? [y/n/m] (5s) "
            # -t 5: give up after 5s with no answer and carry on as "n"
            if ! read -r -t 5 reply; then
                echo
                return
            fi
            case "$reply" in
            # Ctrl+C or 60s without finishing the browser flow returns you to the shell
            [yY]) timeout 60 gcloud auth login && date +%F > "$GCLOUD_STAMP" ;;
            [mM]) date +%F > "$GCLOUD_STAMP"
                    echo "OK, won't ask again today." ;;
            *)    ;;  # n or anything else: skip, ask again next time a terminal spins up
            esac
        fi
    fi
}

agent() {
    eval "$(ssh-agent -s)"
    # sets up cleanup when shell exists, killing the ssh-agent
    # without this every terminal would leave an orphaned running ssh-agent process
    trap 'ssh-agent -k' EXIT

    # select the ssh key to add to the agent
    keys=$(ls ~/.ssh | grep '_rsa$\|_ed25519$\|^id_')
    if [ -z "$keys" ]; then
        echo "No SSH keys found in ~/.ssh"
        return
    fi
    
    selected_key=$(printf "%s\n" "$keys" | fzf --prompt="Select SSH key> ") || return
    if [ -n "$selected_key" ]; then
        ssh-add "$HOME/.ssh/$selected_key"
    fi
}